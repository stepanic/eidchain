# Built binaries
/bin/
/eidchain

# Runtime state: chain data, authority private keys, node config.
# Never commit private keys. data/.gitignore is kept so the directory exists.
/data/*
!/data/.gitignore
*.key
*.p12
*.pfx
*.jks
*.pk8
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
.env
# Host settings for deploy/macos (names this host's tunnel)
/deploy/macos/eidchain.env

# Local scratch and editor files
*.test
*.out
.DS_Store
.idea/
.vscode/
