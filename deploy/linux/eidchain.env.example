# Settings for deploy/linux/install.sh. Copy to deploy/linux/eidchain.env (not in
# git: it names this host's tunnel) and edit.

# This node's own public hostname, advertised to peers. Cloudflare terminates
# TLS and sends the traffic down the tunnel. One name per node, because peer
# exchange tells nodes apart by address. Never a two-level name: the free
# Universal SSL covers *.domovina.ai only.
DOMAIN=eidchain-lenovo.domovina.ai

# More hostnames this node also serves, never advertised (see the macOS example).
ALIASES=

# Everything the node owns lives here, owned by the service user.
PREFIX=/opt/eidchain
SERVICE_USER=eidchain       # a system user, created on the first install
UNIT_PREFIX=eidchain        # units eidchain-{node,nginx,tunnel}.service

# Loopback ports: cloudflared -> nginx -> node. Nothing listens publicly.
NODE_PORT=8095
NGINX_PORT=8096

# cloudflared from Cloudflare's apt repository (install.sh packages); started
# with --no-autoupdate, so apt is what updates it.
CLOUDFLARED=/usr/bin/cloudflared
TUNNEL_ID=                  # from `cloudflared tunnel create eidchain-lenovo`
TUNNEL_METRICS=127.0.0.1:20242

# Other nodes of the chain to gossip with (space-separated base URLs).
PEERS="https://eidchain-i9.domovina.ai/chain https://eidchain-mini.domovina.ai/chain"
