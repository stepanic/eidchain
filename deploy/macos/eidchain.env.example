# Settings for deploy/macos/install.sh. Copy to deploy/macos/eidchain.env (not in
# git: it names this host's tunnel) and edit.

# Public hostname. Cloudflare terminates TLS and sends the traffic down the tunnel.
DOMAIN=eidchain.domovina.ai

# Everything the node owns lives here, owned by the service user.
PREFIX=/opt/eidchain
SERVICE_USER=_eidchain
SERVICE_UID=471            # also the group id; must be free (dscl . -list /Users UniqueID)
LABEL_PREFIX=ai.domovina.eidchain

# Loopback ports: cloudflared -> nginx -> node. Nothing listens publicly.
NODE_PORT=8095
NGINX_PORT=8096

# cloudflared, pinned and without autoupdate. On a host that runs the Gnosis
# node this is the copy that domovina-gnosis-node installs.
CLOUDFLARED=/opt/gnosis/cloudflared/current/cloudflared
TUNNEL_ID=                 # from `cloudflared tunnel create eidchain`
TUNNEL_METRICS=127.0.0.1:20242

# Other nodes of the chain to gossip with (space-separated base URLs). Empty for
# the first node.
PEERS=
